{
  "name": "eldervale",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A handcrafted pixel-art multiplayer woodland RPG.",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:production": "node scripts/verify-production.mjs",
    "assets": "bash scripts/build-assets.sh",
    "install:aseprite": "bash scripts/install-aseprite.sh",
    "format": "prettier --write src shared server tests scripts/*.mjs *.ts *.json README.md art/*.md",
    "format:check": "prettier --check src shared server tests scripts/*.mjs *.ts *.json README.md art/*.md"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
